# Nothing here is needed to run the app — it is all local scratch state.
.cache/
.superdesign/
node_modules/
.DS_Store

# Real team and game data. These are somebody's actual roster, so they stay on
# this machine: the repo is public, and a game belongs in the browser that
# scored it rather than in the source tree. Matched by shape rather than by
# name, so this file does not itself give the team away.
*_roster.csv
*_team*.json
*.local.json
*.local.csv

# A file saved from the browser lands here under whatever name it was given, so
# anything at the top level that is not the project's own is data. package.json
# is the only JSON the project keeps at its root.
/*.csv
/*.json
!/package.json
